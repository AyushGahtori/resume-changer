# Copy this file to .env.local and replace the placeholder values.
# .env.local is ignored by Git. Never commit a real key.

# Which AI backend to use: "gemini" calls Google, "mock" returns fixed local
# responses and never touches the network. Any other value is rejected.
AI_PROVIDER=gemini

# Your Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key

# The model used for every AI operation. Any model that supports structured
# JSON output works. If the selected model is unavailable, the app moves down a
# fallback chain: gemini-flash-lite-latest, then gemini-flash-latest.
GEMINI_MODEL=gemini-3.6-flash

# Optional: how long a single Gemini request may take, in milliseconds.
# Defaults to 240000 (four minutes). The free tier is slower than the paid
# tier, so the budget is generous. A value that is not a positive number is
# ignored and the default is used instead.
# GEMINI_REQUEST_TIMEOUT_MS=240000

# Optional: folder containing data/resume-library.json (not the JSON file itself).
# Linked Git worktrees automatically use the primary checkout's personal data
# when they do not have their own library. An explicit root overrides discovery.
# RESUME_LIBRARY_ROOT=C:/path/to/resume-changer

# Optional: full paths to the PDF toolchain when they are not on PATH.
# TECTONIC_BINARY=C:/Program Files/Tectonic/tectonic.exe
# PDFINFO_BINARY=C:/path/to/poppler/Library/bin/pdfinfo.exe
