AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional: folder containing data/resume-library.json (not the JSON file itself).
# Linked Git worktrees automatically use the primary checkout's personal data
# when they do not have their own library. An explicit root overrides discovery.
# RESUME_LIBRARY_ROOT=C:/path/to/resume-changer
