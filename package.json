{
  "name": "resume-changer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-local.mjs dev",
    "build": "node scripts/build-github-worker.mjs && next build",
    "build:vercel": "node scripts/prepare-pdf-runtime.mjs && node scripts/build-github-worker.mjs && next build",
    "start": "node scripts/run-local.mjs start",
    "worker:build": "node scripts/build-github-worker.mjs",
    "test:worker-smoke": "node scripts/test-github-worker-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{json,mjs,ts,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai-live": "node scripts/test-gemini-live.mjs",
    "test:pdf-live": "node scripts/test-pdf-live.mjs",
    "test:pdf-bundled": "node scripts/test-pdf-bundled.mjs",
    "test:e2e": "playwright test",
    "test:security": "npx -y firebase-tools@15.34.1 emulators:exec --only auth,firestore --project demo-resume-changer-security --config firebase.security.json \"node node_modules/vitest/vitest.mjs run --config vitest.security.config.ts && node scripts/test-account-http.mjs\""
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@vercel/blob": "^2.8.2",
    "firebase": "^13.1.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "next": "^15.5.28",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@next/eslint-plugin-next": "^15.5.28",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ignore": "^7.0.14",
    "jsdom": "^21.1.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "zod": "$zod",
    "postcss": "8.5.31",
    "@grpc/grpc-js": "1.14.6"
  }
}
